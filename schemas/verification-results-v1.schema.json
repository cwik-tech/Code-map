{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-map:verification-results:1",
  "title": "Code-map verification results v1",
  "type": "object",
  "properties": {
    "reportType": {"const": "code-map-verification"},
    "schemaVersion": {"const": 1},
    "runId": {"type": "string","minLength": 1},
    "createdAt": {"type": "string","minLength": 1},
    "profileId": {"type": "string","minLength": 1},
    "ratingRulesVersion": {"type": "string","minLength": 1},
    "ratings": {
      "type": "object",
      "properties": {"structuralIntegrity": {"$ref": "#/$defs/rating"},"verificationCoverage": {"$ref": "#/$defs/rating"},"behavioralConfidence": {"$ref": "#/$defs/rating"},"changeCompleteness": {"$ref": "#/$defs/rating"}},
      "required": ["structuralIntegrity","verificationCoverage","behavioralConfidence","changeCompleteness"],
      "additionalProperties": false
    },
    "obligations": {"type": "array","items": {"$ref": "#/$defs/obligation"}},
    "rubric": {"$ref": "#/$defs/rubric"},
    "ratingScope": {"$ref": "#/$defs/scope"},
    "ratingComparison": {"$ref": "#/$defs/comparison"},
    "readiness": {
      "type": "object",
      "properties": {
        "state": {"enum": ["READY","REVIEW","BLOCKED","INSUFFICIENT_EVIDENCE"]},
        "exitCode": {"type": "integer","minimum": 0,"maximum": 3},
        "blocking": {"type": "array","items": {"type": "string","minLength": 1}},
        "insufficient": {"type": "array","items": {"type": "string","minLength": 1}},
        "review": {"type": "array","items": {"type": "string","minLength": 1}},
        "unassessedCategories": {"type": "array","items": {"type": "string","minLength": 1}},
        "unsupportedCategories": {"type": "array","items": {"type": "string","minLength": 1}},
        "failedCategories": {"type": "array","items": {"type": "string","minLength": 1}},
        "reason": {"type": "string","minLength": 1}
      },
      "required": ["state","exitCode"],
      "additionalProperties": true
    },
    "total": false,
    "average": false,
    "weights": false,
    "combined": false
  },
  "required": ["reportType","schemaVersion","runId","createdAt","profileId","ratingRulesVersion","ratings","obligations","readiness"],
  "additionalProperties": true,
  "$defs": {
    "predicate": {"type": "object","properties": {"id": {"type": "string","minLength": 1},"condition": {"type": "string","minLength": 1}},"required": ["id","condition"],"additionalProperties": false},
    "rubric": {
      "type": "object",
      "properties": {
        "schemaVersion": {"const": 1},
        "profileId": {"type": "string","minLength": 1},
        "ratingRulesVersion": {"type": "string","minLength": 1},
        "evaluatorDigest": {"type": "string","minLength": 1},
        "thresholds": {"type": "object","additionalProperties": {"type": "number"}},
        "decisionTree": {"type": "array","items": {"type": "string","minLength": 1}},
        "evidencePolicy": {
          "type": "object",
          "properties": {
            "eligibility": {"type": "string","minLength": 1},
            "trust": {"type": "string","minLength": 1},
            "minimumAssessment": {"type": "string","minLength": 1},
            "analysisPolicy": {"$ref": "#/$defs/analysisPolicy"},
            "toolMinimums": {"type": "array","items": {"type": "object","properties": {"tool": {"type": "string","minLength": 1},"minimum": {"type": "string","minLength": 1}},"required": ["tool","minimum"],"additionalProperties": false}}
          },
          "required": ["eligibility","trust","minimumAssessment","analysisPolicy","toolMinimums"],
          "additionalProperties": false
        },
        "categories": {
          "type": "object",
          "properties": {
            "structuralIntegrity": {"$ref": "#/$defs/categoryRubric"},
            "verificationCoverage": {"$ref": "#/$defs/categoryRubric"},
            "behavioralConfidence": {"$ref": "#/$defs/categoryRubric"},
            "changeCompleteness": {"$ref": "#/$defs/categoryRubric"}
          },
          "required": ["structuralIntegrity","verificationCoverage","behavioralConfidence","changeCompleteness"],
          "additionalProperties": false
        }
      },
      "required": ["schemaVersion","profileId","ratingRulesVersion","evaluatorDigest","thresholds","decisionTree","evidencePolicy","categories"],
      "additionalProperties": false
    },
    "rating": {
      "type": "object",
      "properties": {
        "state": {"enum": ["RATED","UNASSESSED","NOT_APPLICABLE"]},
        "value": {"type": ["integer","null"],"minimum": 1,"maximum": 5},
        "reason": {"type": "string","minLength": 1},
        "label": {"type": "string","minLength": 1},
        "predicates": {
          "type": "object",
          "properties": {"met": {"type": "array","items": {"type": "string","minLength": 1}},"unmet": {"type": "array","items": {"type": "string","minLength": 1}},"unknown": {"type": "array","items": {"type": "string","minLength": 1}}},
          "required": ["met","unmet","unknown"],
          "additionalProperties": false
        },
        "failures": {"type": "array","items": {"type": "string","minLength": 1}},
        "minimumEvidenceMet": {"type": "boolean"},
        "rubricConfigured": {"type": "boolean"},
        "missingEvidence": {"type": "array","items": {"type": "string","minLength": 1}},
        "predicateEvidence": {"type": "object","additionalProperties": {"type": "array","items": {"type": "string","minLength": 1}}},
        "evidenceCompleteness": {
          "type": "object",
          "properties": {
            "required": {"type": "object","properties": {"completed": {"type": "integer","minimum": 0},"total": {"type": "integer","minimum": 0}},"required": ["completed","total"],"additionalProperties": false},
            "optional": {"type": "object","properties": {"completed": {"type": "integer","minimum": 0},"total": {"type": "integer","minimum": 0}},"required": ["completed","total"],"additionalProperties": false},
            "unknown": {"type": "integer","minimum": 0},
            "skipped": {"type": "integer","minimum": 0}
          },
          "required": ["required","optional","unknown","skipped"],
          "additionalProperties": false
        }
      },
      "required": ["state","value","reason","label"],
      "additionalProperties": true
    },
    "obligation": {
      "type": "object",
      "properties": {
        "id": {"type": "string","minLength": 1},
        "category": {"enum": ["structuralIntegrity","verificationCoverage","behavioralConfidence","changeCompleteness"]},
        "required": {"type": "boolean"},
        "blocking": {"type": "boolean"},
        "severity": {"enum": ["high","medium","low"]},
        "applicability": {"enum": ["APPLICABLE","NOT_APPLICABLE","UNKNOWN"]},
        "applicabilityReason": {"type": "string"},
        "result": {"enum": ["PASS","FAIL","UNKNOWN","SKIPPED","NOT_APPLICABLE"]},
        "eligible": {"type": "boolean"},
        "review": {"enum": ["none","required","resolved"]},
        "evidenceIds": {"type": "array","items": {"type": "string","minLength": 1}},
        "title": {"type": "string"},
        "rationale": {"type": "string"},
        "nextAction": {"type": ["string","null"]}
      },
      "required": ["id","category","required","blocking","severity","applicability","result","eligible","review","evidenceIds"],
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "properties": {
        "repository": {"type": "string","minLength": 1},
        "changeType": {"enum": ["refactor","feature","fix","other"]},
        "allowedPaths": {"type": ["array","null"],"items": {"type": "string","minLength": 1}},
        "acceptanceCriteria": {"type": "array","items": {"type": "object","properties": {"id": {"type": "string","minLength": 1},"text": {"type": "string","minLength": 1}},"required": ["id","text"],"additionalProperties": false}},
        "paths": {"type": "array","items": {"type": "string","minLength": 1}},
        "obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string","minLength": 1},
              "category": {"enum": ["structuralIntegrity","verificationCoverage","behavioralConfidence","changeCompleteness"]},
              "required": {"type": "boolean"},
              "blocking": {"type": "boolean"},
              "severity": {"type": "string","minLength": 1}
            },
            "required": ["id","category","required","blocking","severity"],
            "additionalProperties": false
          }
        },
        "allowedPublicChanges": {"type": ["array","null"],"items": {"type": "string","minLength": 1}},
        "testDeclarations": {
          "type": "object",
          "properties": {
            "regressionTests": {
              "type": "array",
              "items": {"type": "object","properties": {"file": {"type": "string","minLength": 1},"name": {"type": "string","minLength": 1},"mutationAuthorization": {"type": "string","minLength": 1}},"required": ["file"]}
            },
            "generatedTests": {
              "type": "array",
              "items": {"type": "object","properties": {"file": {"type": "string","minLength": 1},"name": {"type": "string","minLength": 1},"mutationAuthorization": {"type": "string","minLength": 1}},"required": ["file"]}
            }
          },
          "required": ["regressionTests","generatedTests"],
          "additionalProperties": false
        }
      },
      "required": ["repository","changeType","allowedPaths","acceptanceCriteria","paths","obligations","allowedPublicChanges","testDeclarations"],
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "properties": {
        "state": {"enum": ["COMPARABLE","INCOMPARABLE","UNKNOWN"]},
        "reasons": {"type": "array","items": {"type": "string","minLength": 1}},
        "categories": {
          "type": "object",
          "properties": {
            "structuralIntegrity": {"$ref": "#/$defs/categoryComparison"},
            "verificationCoverage": {"$ref": "#/$defs/categoryComparison"},
            "behavioralConfidence": {"$ref": "#/$defs/categoryComparison"},
            "changeCompleteness": {"$ref": "#/$defs/categoryComparison"}
          },
          "required": ["structuralIntegrity","verificationCoverage","behavioralConfidence","changeCompleteness"],
          "additionalProperties": false
        },
        "baselineRunId": {"type": "string","minLength": 1}
      },
      "required": ["state","reasons","categories"],
      "additionalProperties": false
    },
    "analysisPolicy": {
      "type": ["object","null"],
      "properties": {
        "config": {"type": "string","minLength": 1},
        "roots": {"type": "array","items": {"type": "string","minLength": 1}},
        "analyzer": {
          "type": "object",
          "properties": {"version": {"type": "string","minLength": 1},"source": {"type": "string","minLength": 1},"typescript": {"type": "string","minLength": 1},"node": {"type": "string","minLength": 1}},
          "required": ["version","source","typescript","node"],
          "additionalProperties": false
        }
      },
      "required": ["config","roots","analyzer"],
      "additionalProperties": false
    },
    "categoryRubric": {
      "type": "object",
      "properties": {
        "fundamental": {"type": "array","items": {"$ref": "#/$defs/predicate"}},
        "bands": {
          "type": "object",
          "properties": {"3": {"type": "array","items": {"$ref": "#/$defs/predicate"}},"4": {"type": "array","items": {"$ref": "#/$defs/predicate"}},"5": {"type": "array","items": {"$ref": "#/$defs/predicate"}}},
          "required": ["3","4","5"],
          "additionalProperties": false
        },
        "required": {"type": "boolean"},
        "allowOptionalAssessment": {"type": "boolean"}
      },
      "required": ["fundamental","bands","required","allowOptionalAssessment"],
      "additionalProperties": false
    },
    "categoryComparison": {
      "type": "object",
      "properties": {
        "state": {"enum": ["COMPARED","UNKNOWN"]},
        "base": {"type": ["integer","null"],"minimum": 1,"maximum": 5},
        "head": {"type": ["integer","null"],"minimum": 1,"maximum": 5},
        "direction": {"enum": ["UP","DOWN","SAME"]},
        "reason": {"type": "string","minLength": 1}
      },
      "required": ["state","base","head"],
      "additionalProperties": false
    }
  }
}
